# push-server 运行配置（复制为 .env 后修改；不要提交真实密钥）
# 是否启用统一登录（SSO）。本服务不提供登录页，密码在 auth-server 配置。
AUTH_ENABLED=true
# 会话签名密钥：必须与 auth-server、TaskOps 完全一致
# 生成示例：openssl rand -hex 32
APP_SECRET=

# --- 统一登录中心（SSO）---
# 未登录访问页面时 302 到这个地址（auth-server 的登录页）
SSO_LOGIN_URL=https://auth.o1-1.xct258.top/login
# 与 auth-server 保持一致
SSO_COOKIE_NAME=sso_session
# 父域，跨子域共享登录态；退出登录时也靠它清除 Cookie
SSO_COOKIE_DOMAIN=.o1-1.xct258.top

# 服务间调用令牌：TaskOps 读取 /records、写入定时任务时使用
PUSH_SERVER_TOKEN=

# 客户端在线状态：超过多少秒收不到心跳就显示离线
PRESENCE_TTL_SECONDS=180

# 端口：MQTT WebSocket / HTTP 管理页与 API
MQTT_WS_PORT=9001
UVICORN_PORT=8383
