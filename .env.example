# push-server 运行配置（复制为 .env 后修改；不要提交真实密钥）
# 是否启用统一登录（SSO）。本服务不提供登录页，登录由 auth-server 统一处理。
AUTH_ENABLED=true

# --- 本服务的独立 SSO 配置（在 auth-server 管理界面创建服务后复制）---
SERVICE_ID=push-server
SSO_LOGIN_URL=https://auth.xct258.top/login
SSO_COOKIE_NAME=sso_push_server
SSO_COOKIE_DOMAIN=.xct258.top
SSO_ALLOWED_REDIRECT_SUFFIX=.xct258.top
# auth-server 集中验签地址；每次受保护请求都会调用
SSO_VERIFY_URL=https://auth.xct258.top/api/auth/verify

# 服务间调用令牌：TaskOps 读取 /records、写入定时任务时使用
PUSH_SERVER_TOKEN=

# 客户端在线状态：超过多少秒收不到心跳就显示离线
PRESENCE_TTL_SECONDS=180

# 端口：MQTT WebSocket / HTTP 管理页与 API
MQTT_WS_PORT=9001
UVICORN_PORT=8383

